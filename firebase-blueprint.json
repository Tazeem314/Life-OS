{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email"]
    },
    "Habit": {
      "title": "Habit",
      "description": "User habit item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" },
        "frequency": { "type": "string" },
        "daysOfWeek": { "type": "array", "items": { "type": "number" } },
        "targetPerWeek": { "type": "number" },
        "startDate": { "type": "string" },
        "status": { "type": "string" },
        "reminderTime": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "frequency", "daysOfWeek", "startDate", "status"]
    },
    "HabitCompletion": {
      "title": "HabitCompletion",
      "description": "Record of a habit completed on a specific date",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "habitId": { "type": "string" },
        "date": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "habitId", "date", "completedAt"]
    },
    "Todo": {
      "title": "Todo",
      "description": "User task item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "priority": { "type": "string" },
        "dueTime": { "type": "string" },
        "notes": { "type": "string" },
        "completed": { "type": "boolean" },
        "order": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "date", "priority", "completed"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User configuration settings",
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "animationsEnabled": { "type": "boolean" },
        "reminderNotifications": { "type": "boolean" },
        "userName": { "type": "string" },
        "sleepSettings": {
          "type": "object",
          "properties": {
            "targetHours": { "type": "number" },
            "targetBedtime": { "type": "string" },
            "targetWakeTime": { "type": "string" },
            "windDownReminder": { "type": "boolean" },
            "windDownMinutesBefore": { "type": "number" }
          }
        }
      },
      "required": ["theme", "animationsEnabled", "reminderNotifications", "userName"]
    },
    "SleepLog": {
      "title": "SleepLog",
      "description": "User sleep record for a night",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "bedtime": { "type": "string" },
        "wakeTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "qualityRating": { "type": "number" },
        "wakeMood": { "type": "string" },
        "awakeningsCount": { "type": "number" },
        "efficiencyScore": { "type": "number" },
        "factors": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "date", "bedtime", "wakeTime", "durationMinutes", "qualityRating"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "User savings target item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string" },
        "category": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "targetAmount", "currentAmount", "category", "status"]
    },
    "SavingsTransaction": {
      "title": "SavingsTransaction",
      "description": "Savings deposit, withdrawal, or transfer record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string" },
        "goalId": { "type": "string" },
        "destinationGoalId": { "type": "string" },
        "category": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "type", "amount", "date"]
    },
    "SavingsSettings": {
      "title": "SavingsSettings",
      "description": "User savings preferences and targets",
      "type": "object",
      "properties": {
        "currency": { "type": "string" },
        "monthlyTarget": { "type": "number" },
        "emergencyFundMonths": { "type": "number" }
      },
      "required": ["currency", "monthlyTarget"]
    },
    "NotificationRecord": {
      "title": "NotificationRecord",
      "description": "User in-app notification record scoped to authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" },
        "readAt": { "type": "string" },
        "priority": { "type": "string" },
        "relatedType": { "type": "string" },
        "relatedId": { "type": "string" },
        "deepLink": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "deduplicationKey": { "type": "string" },
        "deliveryStatus": { "type": "string" },
        "snoozeUntil": { "type": "string" }
      },
      "required": ["id", "category", "title", "message", "createdAt", "read", "priority"]
    },
    "ReminderDefinition": {
      "title": "ReminderDefinition",
      "description": "Custom scheduled user reminder definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "targetDate": { "type": "string" },
        "targetTime": { "type": "string" },
        "timeZone": { "type": "string" },
        "recurring": { "type": "string" },
        "recurrenceDays": { "type": "array", "items": { "type": "number" } },
        "deepLink": { "type": "string" },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "lastTriggeredDate": { "type": "string" },
        "lastTriggeredOccurrence": { "type": "string" }
      },
      "required": ["id", "title", "type", "timeZone", "recurring", "enabled"]
    },
    "NotificationSettings": {
      "title": "NotificationSettings",
      "description": "Per-user notification preferences and quiet hours configuration",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "inAppEnabled": { "type": "boolean" },
        "pushEnabled": { "type": "boolean" },
        "soundEnabled": { "type": "boolean" },
        "timeZone": { "type": "string" },
        "morningBriefingTime": { "type": "string" },
        "eveningReviewTime": { "type": "string" },
        "weeklyReviewDay": { "type": "number" },
        "weeklyReviewTime": { "type": "string" },
        "leadTimeMinutes": { "type": "number" },
        "aiBriefingEnabled": { "type": "boolean" }
      },
      "required": ["enabled", "inAppEnabled", "timeZone"]
    },
    "DismissedNotificationsState": {
      "title": "DismissedNotificationsState",
      "description": "Per-user dismissed notification keys and monotonic clearedAllAt watermark",
      "type": "object",
      "properties": {
        "keys": { "type": "array", "items": { "type": "string" } },
        "clearedAllAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["keys"]
    },
    "AIDailyBriefing": {
      "title": "AIDailyBriefing",
      "description": "Daily AI briefing summary for a specific date",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "summary": { "type": "string" },
        "keyPriorities": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "summary", "createdAt"]
    },
    "PushSubscriptionRecord": {
      "title": "PushSubscriptionRecord",
      "description": "Web push subscription record for the user device",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "endpoint": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastUsedAt": { "type": "string" }
      },
      "required": ["id", "userId", "endpoint", "createdAt"]
    },
    "DeletionRecord": {
      "title": "DeletionRecord",
      "description": "Deletion tombstone marker for synced entities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "deletedAt": { "type": "string" }
      },
      "required": ["id", "type", "deletedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User account document"
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": "Habit",
      "description": "Habit collection for the user"
    },
    "/users/{userId}/habitCompletions/{completionId}": {
      "schema": "HabitCompletion",
      "description": "Habit completion records for the user"
    },
    "/users/{userId}/todos/{todoId}": {
      "schema": "Todo",
      "description": "Todo tasks for the user"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "Goal",
      "description": "Goals for the user"
    },
    "/users/{userId}/sleepLogs/{logId}": {
      "schema": "SleepLog",
      "description": "Sleep logs for the user"
    },
    "/users/{userId}/savingsGoals/{goalId}": {
      "schema": "SavingsGoal",
      "description": "Savings goals for the user"
    },
    "/users/{userId}/savingsTransactions/{transactionId}": {
      "schema": "SavingsTransaction",
      "description": "Savings transactions for the user"
    },
    "/users/{userId}/savingsSettings/{settingsId}": {
      "schema": "SavingsSettings",
      "description": "Savings configuration settings for the user"
    },
    "/users/{userId}/settings/{settingsId}": {
      "schema": "UserSettings",
      "description": "User configuration settings"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "NotificationRecord",
      "description": "User notification records"
    },
    "/users/{userId}/reminders/{reminderId}": {
      "schema": "ReminderDefinition",
      "description": "User scheduled custom reminders"
    },
    "/users/{userId}/notificationSettings/config": {
      "schema": "NotificationSettings",
      "description": "User notification delivery preferences"
    },
    "/users/{userId}/notificationSettings/dismissed": {
      "schema": "DismissedNotificationsState",
      "description": "Dismissed notification keys and clearedAllAt watermark"
    },
    "/users/{userId}/aiBriefings/{briefingId}": {
      "schema": "AIDailyBriefing",
      "description": "Daily AI briefing entries"
    },
    "/users/{userId}/pushSubscriptions/{subscriptionId}": {
      "schema": "PushSubscriptionRecord",
      "description": "Web push subscription endpoints"
    },
    "/users/{userId}/deletions/{deletionId}": {
      "schema": "DeletionRecord",
      "description": "Entity deletion tombstones"
    }
  }
}
